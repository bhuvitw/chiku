# Backend
DATABASE_URL=postgresql+psycopg://chiku:chiku@localhost:5432/chiku
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# Frontend (server-side only; the browser never calls the API directly yet)
API_INTERNAL_URL=http://localhost:8000

# Inference (Phase 2)
# "torch" serves the DVC-tracked checkpoint; "stub" serves deterministic fake
# predictions for tests and UI work. A deployment that means to serve the model
# and cannot find it fails loudly rather than falling back to the stub.
INFERENCE_BACKEND=torch
MODEL_CHECKPOINT=experiments/outputs/resnet18-best.pt

# The operating point is read from the evaluation artifact that chose it, and
# is refused if that artifact was measured on a different checkpoint.
OPERATING_POINT_PATH=experiments/outputs/xray-eval.json
# Overrides. Leave unset to use the calibrated values above; if you set one you
# must set all three.
# DECISION_THRESHOLD=0.4184403121471405
# ABSTENTION_LOW=0.03844031214714033
# ABSTENTION_HIGH=0.7984403121471406

# Queue analysis on the Celery worker instead of running it inline. Needs Redis
# and a running worker; docker-compose sets this to true.
ASYNC_JOBS=false
